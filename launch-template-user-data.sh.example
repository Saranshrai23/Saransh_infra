#!/usr/bin/env bash
set -Eeuo pipefail

install -d -o root -g attendance -m 0750 /etc/attendance-api

# Replace these values through Terraform variables, SSM Parameter Store,
# or AWS Secrets Manager. Do not commit a real password to Git.
cat > /etc/attendance-api/attendance.env <<'ENV'
DB_HOST=REPLACE_WITH_PRIVATE_POSTGRES_ENDPOINT
DB_PORT=5432
DB_NAME=attendance_db
DB_USER=attendance_user
DB_PASSWORD=REPLACE_WITH_SECRET_VALUE
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
ENV

chown root:attendance /etc/attendance-api/attendance.env
chmod 0640 /etc/attendance-api/attendance.env

systemctl daemon-reload
systemctl enable --now attendance-api
